@startuml
title Диаграмма активности: Снятие наличных в банкомате (ATM Cash Withdrawal)

skinparam shadowing false
skinparam monochrome true
skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

start

:Вставить карту;
:Ввести PIN;

if (PIN действителен?) then (да)
  :Ввести сумму снятия;

  if (Достаточно средств на счёте?) then (да)
    :Выдать наличные;
    :Обновить баланс счёта;
  else (нет)
    :Показать сообщение:\n«Недостаточно средств»;
  endif

else (нет)
  :Показать сообщение:\n«Неверный PIN»;
endif

:Извлечь карту;

stop

@enduml